<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Parallel Browser Suite"
       parallel="tests"
       thread-count="3">

    <test name="Chrome Tests">
        <parameter name="BROWSER" value="chrome"/>
        <groups>
            <run>
                <include name="negative"/>
                <include name="integration"/>
                <include name="functional"/>
                <include name="system"/>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="ecom.swaglabs.Add_to_cart.System_testcases_ATC"/>
            <class name="ecom.swaglabs.Product.System_testcases_Product"/>
            <class name="ecom.swaglabs.Login.Smoke_testcases_Login"/>
            <class name="ecom.swaglabs.Add_to_cart.Functional_testcases_ATC"/>
            <class name="ecom.swaglabs.Product.Integartion_testcases_Product"/>
            <class name="ecom.swaglabs.Add_to_cart.Integartion_testcases_ATC"/>
            <class name="ecom.swaglabs.Product.Functionl_testcases_Product"/>
            <class name="ecom.swaglabs.Add_to_cart.Smoke_testcases_ATC"/>
            <class name="ecom.swaglabs.Login.Functional_testcases_Login"/>
            <class name="ecom.swaglabs.Add_to_cart.Negative_testcases_ATC"/>
            <class name="ecom.swaglabs.Login.Negative_testcases_Login"/>
        </classes>
    </test>

    <test name="Firefox Tests">
        <parameter name="BROWSER" value="firefox"/>
        <groups>
            <run>
                <include name="negative"/>
                <include name="integration"/>
                <include name="functional"/>
                <include name="system"/>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="ecom.swaglabs.Add_to_cart.System_testcases_ATC"/>
            <class name="ecom.swaglabs.Product.System_testcases_Product"/>
            <class name="ecom.swaglabs.Login.Smoke_testcases_Login"/>
            <class name="ecom.swaglabs.Add_to_cart.Functional_testcases_ATC"/>
            <class name="ecom.swaglabs.Product.Integartion_testcases_Product"/>
            <class name="ecom.swaglabs.Add_to_cart.Integartion_testcases_ATC"/>
            <class name="ecom.swaglabs.Product.Functionl_testcases_Product"/>
            <class name="ecom.swaglabs.Add_to_cart.Smoke_testcases_ATC"/>
            <class name="ecom.swaglabs.Login.Functional_testcases_Login"/>
            <class name="ecom.swaglabs.Add_to_cart.Negative_testcases_ATC"/>
            <class name="ecom.swaglabs.Login.Negative_testcases_Login"/>
        </classes>
    </test>

    <test name="Edge Tests">
        <parameter name="BROWSER" value="edge"/>
        <groups>
            <run>
                <include name="negative"/>
                <include name="integration"/>
                <include name="functional"/>
                <include name="system"/>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="ecom.swaglabs.Add_to_cart.System_testcases_ATC"/>
            <class name="ecom.swaglabs.Product.System_testcases_Product"/>
            <class name="ecom.swaglabs.Login.Smoke_testcases_Login"/>
            <class name="ecom.swaglabs.Add_to_cart.Functional_testcases_ATC"/>
            <class name="ecom.swaglabs.Product.Integartion_testcases_Product"/>
            <class name="ecom.swaglabs.Add_to_cart.Integartion_testcases_ATC"/>
            <class name="ecom.swaglabs.Product.Functionl_testcases_Product"/>
            <class name="ecom.swaglabs.Add_to_cart.Smoke_testcases_ATC"/>
            <class name="ecom.swaglabs.Login.Functional_testcases_Login"/>
            <class name="ecom.swaglabs.Add_to_cart.Negative_testcases_ATC"/>
            <class name="ecom.swaglabs.Login.Negative_testcases_Login"/>
        </classes>
    </test>

</suite>
